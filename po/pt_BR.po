#: synaptix/app.py:25
msgid "Start without opening a window"
msgstr "Iniciar sem abrir uma janela"

#: synaptix/app.py:102
msgid "Synaptix keeps your device lighting and idle dimming running."
msgstr "O Synaptix mantém a iluminação dos dispositivos e o escurecimento por inatividade funcionando."

#: synaptix/app.py:120 synaptix/window.py:436 synaptix/window.py:464
#: synaptix/window.py:467 synaptix/window.py:536
msgid "Synaptix"
msgstr "Synaptix"

#: synaptix/app.py:127
msgid ""
"Lighting control for Razer peripherals, talking to the devices directly over "
"USB HID. Not affiliated with Razer Inc."
msgstr "Controle de iluminação para periféricos Razer, conversando com os dispositivos diretamente por USB HID. Não é afiliado à Razer Inc."

