#: synaptix/window.py:491
#, python-brace-format
msgid ""
"Connect a Razer keyboard, mouse, mouse mat or accessory. {count} models are "
"known, and other models are detected automatically."
msgstr "Conecte um teclado, mouse, mousepad ou acessório Razer. {count} modelos são conhecidos, e outros modelos são detectados automaticamente."

#: synaptix/window.py:503
msgid "Copy Command"
msgstr "Copiar comando"

#: synaptix/window.py:508
msgid "Permission Needed"
msgstr "Permissão necessária"

#: synaptix/window.py:509
msgid ""
"This device was found, but Synaptix is not allowed to talk to it yet. Run "
"this command once in a terminal; it installs a udev rule that gives your "
"user access to Razer devices. Synaptix will connect automatically."
msgstr "Este dispositivo foi encontrado, mas o Synaptix ainda não tem permissão para se comunicar com ele. Execute este comando uma vez em um terminal; ele instala uma regra udev que dá ao seu usuário acesso aos dispositivos Razer. O Synaptix vai se conectar automaticamente."

#: synaptix/window.py:522
msgid "Permission needed"
msgstr "Permissão necessária"

#: synaptix/window.py:522
msgid "Not supported"
msgstr "Não suportado"

#: synaptix/window.py:559
#, python-brace-format
msgid "{name} uses a lighting protocol Synaptix does not speak yet."
msgstr "{name} usa um protocolo de iluminação que o Synaptix ainda não conhece."

#: synaptix/window.py:592
msgid "Command copied"
msgstr "Comando copiado"
